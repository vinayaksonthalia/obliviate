{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObliviateCertBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:PutObjectRetention",
        "s3:GetObjectRetention",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::obliviate-certs-vinayak",
        "arn:aws:s3:::obliviate-certs-vinayak/*"
      ]
    }
  ]
}
